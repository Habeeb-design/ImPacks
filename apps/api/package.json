{
  "name": "@impacks/api", "version": "0.1.0", "private": true, "type": "module",
  "scripts": {
    "predev": "npm run build -w @impacks/contracts",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc", "typecheck": "tsc --noEmit",
    "pretest": "npm run build -w @impacks/contracts",
    "test": "node --import tsx --test test/*.test.ts",
    "start": "node --env-file-if-exists=.env dist/index.js"
  },
  "dependencies": { "@impacks/contracts": "*", "fastify": "^5.6.2", "zod": "^4.1.12" },
  "devDependencies": { "tsx": "^4.20.6" }
}
