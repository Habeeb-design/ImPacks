# Simulated packs are the default. Optional durable Crypto purchases use test AUSD
# and Gemini sandbox USD only when the pipeline and worker are explicitly enabled.

# Demo pack providers remain simulated; checkout storage and verification are independent.
APP_MODE=demo
HOST=127.0.0.1
PORT=3001
# Server-side sandbox credentials for the optional purchase worker.
GEMINI_API_KEY=
GEMINI_API_SECRET=
GEMINI_NONCE_MODE=time
SANDBOX_PIPELINE_ENABLED=0
# Explicit lifetime reservation/spending ceiling and conservative fee reserve.
# See docs/PURCHASE_PIPELINE.md before choosing these values or enabling.
# GEMINI_SANDBOX_BUDGET_CENTS=2000
# GEMINI_FEE_RESERVE_BPS=1000
# Worker only: apps/api/.env.pipeline-worker, never loaded by API/frontend.
# AUSD_REFUND_PRIVATE_KEY=0x...
# AUSD_REFUND_BROADCAST_ENABLED=1

# Public ID used for ES256 access-token verification against Privy JWKS.
PRIVY_APP_ID=

# Ethereum Sepolia RPC for wallet balances and the optional welcome-grant worker.
ETHEREUM_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Optional automatic welcome grant: exactly 50 test AUSD to each eligible new
# Privy user's embedded Ethereum wallet. Requires standalone API + worker + Postgres.
# Keep disabled until docs/WELCOME_GRANTS.md setup is complete.
WELCOME_GRANTS_ENABLED=0
# Configure an explicit UTC launch time. Existing users before it are excluded.
# WELCOME_GRANTS_STARTS_AT=2026-10-11T00:00:00Z
# WELCOME_GRANTS_TREASURY_ADDRESS=0x...
# Maximum newly signed 50-AUSD grants per UTC day (required when enabled).
# WELCOME_GRANTS_DAILY_LIMIT=100
# DATABASE_URL=postgresql://...
# API only: signing secret for user.created / user.wallet_created webhooks.
# PRIVY_WEBHOOK_SIGNING_SECRET=whsec_...
# Worker only: put these in apps/api/.env.grants-worker locally, or worker server
# secrets when hosted. The API and frontend do not load that local file.
# PRIVY_APP_SECRET=
# WELCOME_GRANTS_PRIVATE_KEY=0x...

# DATABASE_URL=

# AUSD verification; no private key needed. Keep APP_MODE=demo for the separate demo flow.
# Supply your Ethereum Sepolia HTTP(S) RPC URL (chain 11155111).
AUSD_RPC_URL=
AUSD_CONTRACT_ADDRESS=0xa9012a055bd4e0eDfF8Ce09f960291C09D5322dC
# Public receiving wallet address; required for checkout creation, optional for connectivity.
AUSD_RECIPIENT_ADDRESS=
# Optional outside Docker: defaults to apps/api/data/checkout.sqlite.
# Use a persistent local disk. Never a temporary filesystem or per-replica files.
# AUSD_DATABASE_PATH=/absolute/persistent/path/checkout.sqlite
# Minimum 12 blocks, including the receipt block. Higher values may be configured.
AUSD_MIN_CONFIRMATIONS=12
# Exact browser application origin. No trailing slash, path, or wildcard.
# Use HTTPS outside localhost. Never derive this from Host/X-Forwarded-Host.
APP_ORIGIN=http://localhost:3000
# Server-to-server secret (at least 32 characters). Generate securely; never NEXT_PUBLIC_*.
# Required only for the internal fulfillment API; share with the trusted issuer backend.
INTERNAL_FULFILLMENT_KEY=
# Payment availability requires explicit pipeline configuration and a ready worker.

# Optional user-to-user PAPER resale. No AUSD or Gemini calls.
POSTTRADE_DEMO_ENABLED=0
# Standalone API on a persistent volume; one SQLite database per installation.
# POSTTRADE_DB_PATH=data/posttrade.sqlite

# Opt-in testnet platform advance: execute first, collect AUSD after reveal.
# Bound by GEMINI_SANDBOX_BUDGET_CENTS and one unpaid advance per verified account/wallet.
TESTNET_PLATFORM_ADVANCE_ENABLED=0
