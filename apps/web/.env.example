# Server-side Next.js API proxy target. Never exposed to the browser.
API_PROXY_TARGET=http://127.0.0.1:3001
# Explicit opt-in for a single-process, ephemeral hosted demo (no real transactions).
IMPACKS_EMBEDDED_DEMO=0
# Optional public API origin, inlined at build time; empty uses the same-origin handler.
NEXT_PUBLIC_API_BASE_URL=

# Public Privy app ID; never add the app secret here.
NEXT_PUBLIC_PRIVY_APP_ID=
