{
  "name": "@impacks/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build -w @impacks/contracts && npm run build -w @impacks/api",
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "typecheck": "next typegen && tsc --noEmit",
    "start": "next start --port 3000"
  },
  "dependencies": {
    "@impacks/api": "*",
    "@impacks/contracts": "*",
    "@privy-io/react-auth": "3.48.1",
    "next": "^16.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  }
}
